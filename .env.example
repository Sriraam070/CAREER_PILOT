# Copy to .env (git-ignored). Only fill what you use.

# Claude (chat, AI interview prep, AI skill extraction)
ANTHROPIC_API_KEY=
# CAREERPILOT_MODEL=claude-opus-5-5

# Notion: create an internal integration at notion.so/my-integrations,
# then open your Job Tracker → ••• → Connections → add the integration.
NOTION_TOKEN=
NOTION_DATABASE_ID=3648798076d94d5b9d1baffdf0422517

# Adzuna job API (free): developer.adzuna.com. Used for companies without a public careers API.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Gmail: Google Account → Security → 2-Step Verification → App passwords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=

# WhatsApp: EITHER Twilio (reliable) ...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
# ... OR CallMeBot (free, personal use: callmebot.com/blog/free-api-whatsapp-messages)
CALLMEBOT_APIKEY=
WHATSAPP_TO=+91XXXXXXXXXX

# Optional password for the web app
CAREERPILOT_APP_PASSWORD=
